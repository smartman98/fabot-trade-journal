# 실제 값은 .env 파일에만 넣으세요 (이 파일은 예시일 뿐, git에 커밋해도 안전합니다)
SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
SUPABASE_SERVICE_KEY=여기에_service_role_키를_붙여넣으세요
PORT=3400

# 게스트에게는 계좌 잔고/매매 기록을 가리고, 이 아이디·비밀번호로 로그인해야만 보이게
# 함(2026-09-13). fabot-daily-briefing-agent와 같은 값을 써도 됨(로그인 하나로 통일).
APP_USERNAME=여기에_아이디
APP_PASSWORD=여기에_비밀번호
# 로그인 세션 토큰 서명용 임의의 긴 문자열 — 이 값을 바꾸면 기존 로그인이 전부 풀림
SESSION_SECRET=여기에_임의의_긴_문자열
